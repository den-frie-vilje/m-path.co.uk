# Committed per-mode public env — PUBLIC_* values only, never secrets.
# Loaded by Vite at build time (`--mode production`, the default); read via
# $env/static/public, which fails the build loudly on a missing declaration.

# robots.txt switch: only the literal "true" bakes the Allow-all + sitemap-advert
# variant. Anything else bakes Disallow-all (fail-closed).
PUBLIC_ALLOW_INDEXING=true
