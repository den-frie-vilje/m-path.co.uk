node_modules
/build
/.svelte-kit
/package
# Local-only secrets / overrides. The per-mode .env.development, .env.staging,
# .env.production files ARE committed — they carry only PUBLIC_* values (no
# secrets) and must be on disk at build time for $env/static/public. Unscoped
# .env and *.local (below) stay ignored.
.env
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.DS_Store
# Generated responsive photo variants — regenerated by `prebuild` (gen-photos),
# hash-gated via the committed src/lib/photo-manifest.json.
/static/img/photos/_gen/
/scripts/.photo-cache
# Self-hosted Sveltia bundle — copied from node_modules by prebuild.
/static/admin/sveltia-cms.js
*.local
