# Staging (`--mode staging`, set by deploy-staging.yml → Dockerfile VITE_MODE):
# bakes Disallow-all robots.txt — the stage origin must never be indexed in
# place of m-path.co.uk.
PUBLIC_ALLOW_INDEXING=false
# Stage-host canonicals/OG/sitemap so the staging build is self-consistent
# (the whole origin is noindexed — baked robots + X-Robots-Tag front door).
PUBLIC_SITE_URL=https://m-path-co-uk.stage.denfrievilje.dk
